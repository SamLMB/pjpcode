<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title }} — PJP code</title>
  <link rel="stylesheet" href="/pjpcode/style.css">
</head>
<body class="recipe">
  <header class="site-header">
    <a href="/pjpcode/voici.htm" class="back">← sommaire</a>
    <span class="brand">PJP code</span>
  </header>

  <article>
    <p class="recipe-number">Recette n°{{ number }}</p>
    <h1>{{ title }}</h1>
    {%- if subtitle %}
    <p class="subtitle">{{ subtitle }}</p>
    {%- endif %}

    <div class="recipe-body">
      {{ content | safe }}
    </div>

    {%- if pdf %}
    <p class="downloads">
      Aussi disponible en
      <a href="recipe.pdf">PDF</a>{% if docx %} et
      <a href="recipe.docx">Word</a>{% endif %}.
    </p>
    {%- endif %}
  </article>

  <footer class="site-footer">
    <p>PJP code — recette n°{{ number }}</p>
  </footer>
</body>
</html>
